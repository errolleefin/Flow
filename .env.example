# Server Configuration (Local / VPS / Docker)
PORT=3001
HOST=0.0.0.0
FLOW_DB_PATH=./data/flow.sqlite

# Optional: login session lifetime in days (default 30)
# FLOW_SESSION_TTL_DAYS=30
# Optional: comma-separated origins allowed to call the API cross-origin.
# CORS is off by default (Vite proxies /api in dev; production is same-origin).
# FLOW_CORS_ORIGIN=https://flow.example.com

# Optional: PostgreSQL / Supabase storage instead of SQLite (required on Vercel).
# Supabase: Dashboard -> Connect -> Transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
# Optional: CA certificate (PEM, "\n" for line breaks) to verify the database
# server certificate. Supabase: Database Settings -> SSL Configuration.
# FLOW_PG_SSL_CA=
# Optional: PostgreSQL connection pool size per server instance (default 3)
# FLOW_PG_POOL_MAX=3

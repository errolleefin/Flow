{
  "name": "flow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Flow — AI 驱动的本地全栈多维工作 Todo 与看板管理系统",
  "scripts": {
    "dev:server": "node --no-warnings server/index.mjs",
    "dev:client": "vite --port 5173 --host",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc -b && vite build",
    "start": "node --no-warnings server/index.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
